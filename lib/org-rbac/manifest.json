{
  "schemaVersion": "1.0",
  "name": "@viba/org-rbac",
  "version": "1.0.0",
  "category": "identity-access",
  "runtime": "node>=22",
  "database": "postgresql>=15",
  "entrypoint": "dist/index.js",
  "migrations": ["migrations/001_org_rbac.sql"],
  "capabilities": [
    "multi-tenant-organizations",
    "memberships",
    "invitations",
    "custom-roles",
    "granular-permissions",
    "ownership-transfer",
    "immutable-audit-events"
  ],
  "security": {
    "authorizationDefault": "deny",
    "tenantIsolation": true,
    "invitationTokensStoredAsHashes": true
  }
}
